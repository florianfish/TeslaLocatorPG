# Access Tokens: Separate admin and user tokens (e.g. ?token=...)
# ADMIN_ACCESS_TOKEN gives full access including MQTT console & test simulation.
# USER_ACCESS_TOKEN gives view-only access to map and telemetry gauges.
ADMIN_ACCESS_TOKEN="admin_secret_token"
USER_ACCESS_TOKEN="user_secret_token"
# Legacy fallback (treated as admin token if ADMIN_ACCESS_TOKEN is not set)
SECURE_ACCESS_TOKEN="xxxxxxxxxxx"

# PUBLIC_URL: Public address used to build share links (e.g. https://tesla.example.com).
# Defaults to the address of the request that created the link.
PUBLIC_URL=""

# MQTT Configuration
MQTT_BROKER_URL="mqtt://xxx.xxx.xxx.xxx:1883"
MQTT_USERNAME="xxxxx"
MQTT_PASSWORD="xxxxx"
MQTT_TOPIC="teslamate/cars/1/location"
