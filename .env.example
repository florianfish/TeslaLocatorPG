# Access Tokens: Separate admin and user tokens (e.g. ?token=...)
# ADMIN_ACCESS_TOKEN gives full access including MQTT console & test simulation.
# USER_ACCESS_TOKEN gives view-only access to map and telemetry gauges.
ADMIN_ACCESS_TOKEN="admin_secret_token"
USER_ACCESS_TOKEN="user_secret_token"
# Legacy fallback (treated as admin token if ADMIN_ACCESS_TOKEN is not set)
SECURE_ACCESS_TOKEN="xxxxxxxxxxx"

# PUBLIC_URL: Public address used to build share links (e.g. https://tesla.example.com).
# Defaults to the address of the request that created the link.
PUBLIC_URL=""

# Telegram notifications (optional): bot token from @BotFather, chat id(s) separated by commas
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Enabled by default once Telegram is configured
NOTIFY_CHARGE_STARTED="true"
NOTIFY_CHARGE_COMPLETE="true"
NOTIFY_TPMS="true"
NOTIFY_CHARGE_ENDING_SOON="true"
NOTIFY_BATTERY_LOW="true"
NOTIFY_LEFT_OPEN="true"
# Tyre pressure alert threshold, in bar
TPMS_ALERT_THRESHOLD="2.3"
# Remaining charging time (minutes) for the "charge ending soon" alert
CHARGE_ENDING_SOON_MINUTES="15"
# Low battery alert threshold, in %
BATTERY_LOW_THRESHOLD="20"
# Minutes the car must stay unlocked/open (parked, nobody inside) before the alert
LEFT_OPEN_DELAY_MINUTES="10"
# Bot commands (/position, /etat, /charge, /partage), answered only in TELEGRAM_CHAT_ID chats
TELEGRAM_COMMANDS="true"
# Timezone used for the expected end-of-charge time
TZ="Europe/Paris"

# Charging control (optional): Home Assistant switch that starts / stops charging
# (Tesla Fleet, Teslemetry or Tessie integration). Outside the add-on, HA_URL and a
# long-lived access token (Home Assistant profile > Security) are also required.
CHARGE_SWITCH_ENTITY=""
HA_URL=""
HA_TOKEN=""

# MQTT Configuration
MQTT_BROKER_URL="mqtt://xxx.xxx.xxx.xxx:1883"
MQTT_USERNAME="xxxxx"
MQTT_PASSWORD="xxxxx"
MQTT_TOPIC="teslamate/cars/1/location"
