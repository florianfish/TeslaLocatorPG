    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "mqtt": "^5.15.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
